# Optional: Open-Meteo supports non-commercial access without an API key.
# Never commit real credentials to this repository.
OPEN_METEO_API_KEY=

# Optional explanation only; forecasts and replay work without OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Source SCADA timestamps have no timezone marker. civil_time applies Asia/Almaty
# historical IANA rules. fixed_offset requires the explicit value below.
SCADA_TIMESTAMP_MODE=civil_time
SCADA_FIXED_UTC_OFFSET_HOURS=5
# Daily forecast convention: 00:00 Asia/Almaty, converted to UTC internally.
FORECAST_ORIGIN_CONVENTION=almaty_midnight
WEATHER_AVAILABILITY_LAG_HOURS=7
